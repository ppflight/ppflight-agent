[Unit]
Description=PPFlight private node_exporter
Documentation=https://github.com/prometheus/node_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ppflight-nodeexp
Group=ppflight-nodeexp
ExecStart=/usr/local/lib/ppflight-agent/node_exporter --web.listen-address=127.0.0.1:9100 --collector.systemd --collector.processes
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
# node_exporter probes a wide range of procfs/sysfs kernel interfaces.  A
# positive syscall allow-list is too brittle across PVE 8/9 kernels and Go
# runtime releases and can terminate the exporter during its first scrape.
# Keep an explicit deny-list for syscall families the unprivileged service
# never needs while allowing read-only host metric discovery to work.
SystemCallFilter=~@clock @cpu-emulation @debug @keyring @memlock @module @mount @obsolete @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
