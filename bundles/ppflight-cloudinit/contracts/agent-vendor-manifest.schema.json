{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppflight.com/schemas/agent-vendor-manifest.v1.json",
  "title": "PPFlight Agent cloudinit vendor manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleVersion", "catalogRevision", "catalogSha256", "entrypoint", "files", "dependencies", "networkHosts", "networkRedirectPolicy"],
  "properties": {
    "schemaVersion": {"const": "ppflight.agent-vendor-manifest/v1"},
    "bundleVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "catalogRevision": {"type": "string"},
    "catalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entrypoint": {"const": "tools/ppflight-template-bootstrap.py"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "requiredAtRuntime"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "requiredAtRuntime": {"type": "boolean"}
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "bash", "commands", "perlModules"],
      "properties": {
        "python": {"const": ">=3.9"},
        "bash": {"const": ">=5"},
        "commands": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "perlModules": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "networkHosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "hostname"}
    },
    "networkRedirectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "schemes", "addressFamily", "hostPolicy", "integrityPolicy"],
      "properties": {
        "allowed": {"const": true},
        "schemes": {"const": ["https"]},
        "addressFamily": {"const": "ipv4-only"},
        "hostPolicy": {"const": "upstream-selected"},
        "integrityPolicy": {"const": "catalog-sha256-and-official-checksum"}
      }
    }
  }
}
