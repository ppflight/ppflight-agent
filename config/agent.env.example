# Copy to /etc/ppflight-agent/agent.env and set mode 0640, root:ppflight-agent.
# Never commit this file after adding real values. Keep PVE read and control
# write credentials separate. Values below are placeholders, not usable secrets.

# Used only after pve.source is changed from simulator to api.
PVE_READ_TOKEN_ID=
PVE_READ_TOKEN_SECRET=

# Website metering/telemetry HMAC credential (one per cluster).
WEBSITE_METERING_KEY_ID=
WEBSITE_METERING_SECRET=
WEBSITE_TELEMETRY_KEY_ID=
WEBSITE_TELEMETRY_SECRET=

# Existing monitoring control plane bearer credential, if that destination uses it.
MONITORING_BEARER_TOKEN=

# Website-to-agent control channel credentials. These must differ from all PVE tokens.
CONTROL_API_KEY_ID=
CONTROL_API_SECRET=
CONTROL_COMMAND_SECRET=

# Required only when mode=production and control.productionExecution=true.
# This token is intentionally separate from PVE_READ_TOKEN_*.
PVE_CONTROL_TOKEN_ID=
PVE_CONTROL_TOKEN_SECRET=
