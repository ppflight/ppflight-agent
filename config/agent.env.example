# Copy to /etc/ppflight-agent/agent.env with mode 0600, owner root:root.
# Never commit the populated file. The PVE credential bootstrap atomically
# replaces these four local-only values; it never prints or uploads secrets.

# Dedicated read identity used when pve.source=api.
PVE_READ_TOKEN_ID=
PVE_READ_TOKEN_SECRET=

# Separate write identity, used only when production execution is explicitly
# enabled. The bootstrap creates it without ACL by default.
PVE_CONTROL_TOKEN_ID=
PVE_CONTROL_TOKEN_SECRET=

# Website endpoint HMAC credentials and the Ed25519 public key are issued by
# `ag-pve bind` and live in <stateDirectory>/bindings/binding-state.json,
# not in this template.
# Monitoring uses a different one-time binding and private
# <stateDirectory>/bindings/monitoring-binding-state.json; never paste website
# credentials here for it.
